<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- WebView 由代码创建：需要重写 density 以保证 CSS 视口不低于 1920×1080 -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="@color/accent" />

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF060A13"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/loading"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 加载失败 -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6060A13"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingTop="44dp"
            android:paddingEnd="64dp"
            android:paddingBottom="44dp">

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/error_network"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/retryButton"
                android:layout_width="260dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="@string/retry"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/web_key_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 白屏兼容性提示：页面加载成功但没有任何可显示内容时给出原因（不抢焦点，按键仍归 WebView） -->
    <LinearLayout
        android:id="@+id/compatPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6060A13"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingTop="44dp"
            android:paddingEnd="64dp"
            android:paddingBottom="44dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compat_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compatMessage"
                android:layout_width="720dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/compat_blank"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/compat_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 轮询指示：仅在轮询播放模式下显示（第 i/n 页 + 倒计时） -->
    <TextView
        android:id="@+id/rotationChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_hint_bar"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 信息浮层：进入页面或按菜单键时短暂显示；置于左下角，避免遮挡页面自身顶部标题/页签栏 -->
    <TextView
        android:id="@+id/infoOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:alpha="0"
        android:background="@drawable/bg_hint_bar"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="invisible" />

</FrameLayout>
