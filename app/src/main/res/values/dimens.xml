<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 大屏交互尺寸：元素间距与触达区域按电视遥控器操作规范放大。
         设计画布按 Android TV 规范取 960dp × 540dp（1080p @2 倍密度），
         以下数值需保证「6 个入口按 2 行 × 3 列全部落在 540dp 高度内且不被裁切」。 -->
    <dimen name="screen_padding_h">56dp</dimen>
    <dimen name="screen_padding_v">28dp</dimen>

    <!-- 顶栏要容纳 30sp 标题 + 14sp 副标题，同时不能挤压下方两行卡片（按 540dp 画布实测 68dp 刚好不溢出） -->
    <dimen name="topbar_height">68dp</dimen>
    <dimen name="bottombar_height">40dp</dimen>

    <dimen name="card_gap">12dp</dimen>
    <!-- 卡片高度下限：保证卡片内容不被压缩；实际高度按行数自适应铺满（见 adaptiveCardHeight） -->
    <dimen name="card_height">164dp</dimen>
    <!-- 卡片高度上限：入口较少（单行）时避免卡片被拉得过高 -->
    <dimen name="card_max_height">260dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_radius">12dp</dimen>

    <!-- 栅格内边距：横向留白用于容纳焦点卡片放大 1.05 倍的溢出，避免左右被裁 -->
    <dimen name="grid_padding_h">10dp</dimen>
    <dimen name="grid_padding_v">16dp</dimen>

    <dimen name="icon_box_size">32dp</dimen>
    <dimen name="icon_size">20dp</dimen>

    <!-- 首页/展示页系统标题：电视观看距离远，字号需明显大于卡片标题 -->
    <dimen name="text_title_home">30sp</dimen>
    <dimen name="text_title_sub">14sp</dimen>
    <dimen name="text_card_title">16sp</dimen>
    <dimen name="text_card_subtitle">12sp</dimen>
    <dimen name="text_chip">12sp</dimen>
    <dimen name="text_hint">13sp</dimen>
    <dimen name="text_clock">22sp</dimen>
    <dimen name="text_date">11sp</dimen>

    <dimen name="dialog_radius">18dp</dimen>
    <dimen name="dialog_btn_width">176dp</dimen>
    <dimen name="dialog_btn_height">58dp</dimen>
</resources>
